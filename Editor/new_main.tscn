[sub_resource type="GDScript" id="GDScript_1fxgr"]
script/source = "extends Control

@onready var brush_toolbox: GridContainer = $CenterContainer/BrushToolbox
@onready var object_toolbox: GridContainer = $CenterContainer/ObjectToolbox
@onready var all_toolboxes := [brush_toolbox,object_toolbox]

enum toolboxes {
	brush_toolbox,
	object_toolbox
}

@onready var active_toolbox: GridContainer = $CenterContainer/BrushToolbox

signal brush_changed(brush: TileMapManager.Brushes)

func change_toolbox(toolbox:toolboxes):
	active_toolbox.hide()
	active_toolbox = all_toolboxes[toolbox]
	active_toolbox.show()



func _on_paint_btn_pressed() -> void:
	brush_changed.emit(TileMapManager.Brushes.paint)


func _on_line_btn_pressed() -> void:
	brush_changed.emit(TileMapManager.Brushes.line)


func _on_rect_btn_pressed() -> void:
	brush_changed.emit(TileMapManager.Brushes.rect)


func _on_fill_cell_btn_pressed() -> void:
	brush_changed.emit(TileMapManager.Brushes.fill)


func _on_inventory_selection_changed(item: InventoryItem) -> void:
	if item.bulk_placement:
		change_toolbox(toolboxes.brush_toolbox)
	else:
		change_toolbox(toolboxes.object_toolbox)
"

