[sub_resource type="GDScript" id="GDScript_go5yj"]
script/source = "extends ColorRect


func _enter_tree() -> void:
	set_notify_transform(true)

func _notification(what: int) -> void:
	if what == NOTIFICATION_TRANSFORM_CHANGED:
		
		material.set_shader_parameter(\"grid_offset\", -global_position + Vector2(14.5,13.5))

func _on_world_viewport_mouse_moved(coords: Vector2) -> void:
	## for the grid highlight
	material.set_shader_parameter(\"mouse_position\", coords)
"

