[sub_resource type="GDScript" id="GDScript_jgecq"]
script/source = "extends LineEdit

var last_text: String

var keys = \"ABCabcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ123456789_\"


func lock():
	editable = false
	release_focus()
	focus_mode = Control.FOCUS_NONE


func unlock():
	editable = true
	focus_mode = Control.FOCUS_ALL


func update(new_text:String):
	text = new_text

func _on_gui_input(event: InputEvent) -> void:
	if event is InputEventKey:
		if event.pressed:
			if event.as_text() in keys:
				pass
				
			elif event.is_action_pressed(\"ui_text_backspace\"):
				pass
			
			elif event.is_action_pressed(\"ui_text_submit\"):
				release_focus()
				accept_event()
			else:
				accept_event()
"

