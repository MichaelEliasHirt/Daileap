[sub_resource type="GDScript" id="GDScript_1fxgr"]
script/source = "extends Control

@onready var brush_toolbox: GridContainer = $BrushToolbox
@onready var object_toolbox: GridContainer = $ObjectToolbox
@onready var all_toolboxes := [brush_toolbox,object_toolbox]

enum toolboxes {
	brush_toolbox,
	object_toolbox
}

var active_toolbox: GridContainer

func change_toolbox(toolbox:toolboxes):
	active_toolbox.hide()
	active_toolbox = all_toolboxes[toolbox]
	active_toolbox.show()
		
"

